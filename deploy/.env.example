# Modèle de deploy/.env (créé par install.sh, jamais commité).
# Reprends les valeurs actuelles de Render : dashboard → one-moov-api → Environment.

# Sous-domaine de l'API : son enregistrement DNS A doit pointer vers l'IP du VPS.
API_DOMAIN=api.onemoov.org

# Générés automatiquement par install.sh.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_HOURS=720

# LLM Groq
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_MODEL_LEGER=llama-3.1-8b-instant

# Vérification RNCP par LLM web (Perplexity)
RNCP_LLM_API_KEY=
RNCP_LLM_BASE_URL=https://api.perplexity.ai
RNCP_LLM_MODEL=sonar

# Paiement CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=SANDBOX
PRIX_PARCOURS_EUR=80
TAUX_EUR_FCFA=655.957

# E-mail via Brevo. SMTP_FROM doit être un expéditeur validé dans Brevo :
# recopie exactement la valeur utilisée sur Render.
EMAIL_VERIFICATION_REQUISE=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=One Moov <no-reply@onemoov.app>
SMTP_TLS=true

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_RAPPEL_TEMPLATE_SID=

# Garde-fous
QUOTA_MESSAGES_GRATUIT_JOUR=40
BUDGET_MENSUEL_USD=200
