# Copier en .env pour le développement local. Ce fichier est ignoré par git.
#
#     cp .env.exemple .env      puis coller ses clés, et c'est tout.
#
# Les FOURNISSEURS sont déjà réglés sur ceux que le projet recommande. Les
# CLÉS, elles, sont vides — il n'y a qu'elles à remplir.
#
# Pourquoi c'est sans risque de nommer un fournisseur sans lui donner de clé
# ------------------------------------------------------------------------
# Un fournisseur dont la clé est vide est purement ignoré. L'orchestrateur
# descend alors au niveau 3, le mode guidé : l'orientation devient un
# questionnaire à choix, le chatbot répond à partir des passages trouvés sans
# les reformuler, l'entretien est noté sur grille. La recherche reste en plein
# texte français. Les notifications s'écrivent dans les journaux.
#
# Autrement dit, ce fichier tel quel donne exactement le même comportement que
# pas de fichier du tout — et poser une seule clé suffit à allumer la fonction
# correspondante, sans rien changer d'autre.
#
# C'est pour éviter le piège inverse : un modèle qui aurait dit
# LLM_PROVIDER=mock obligerait à modifier DEUX lignes pour brancher Groq, et
# celui qui n'en change qu'une se demanderait pendant une heure pourquoi son
# application répond encore en mode guidé.

DATABASE_URL=postgresql+psycopg2://onemoov:onemoov@localhost:5432/onemoov


# ============================================================================
# QUEL FOURNISSEUR POUR QUOI
# ============================================================================
#
#   Fonction                Fournisseur retenu   Pourquoi celui-là
#   ----------------------  -------------------  --------------------------
#   Orientation, guidée     aucun                Sept questions dans un ordre
#                                                fixe. Aucun modèle, donc
#                                                jouable hors ligne.
#   Orientation, libre      Groq                 Extraction de champs depuis
#                                                un récit : la latence compte
#                                                plus que la finesse, et Groq
#                                                répond en quelques centaines
#                                                de millisecondes.
#   Feuille de route        Mistral (europe)     C'est le livrable payé. Bon
#                                                français, sortie JSON fiable,
#                                                et un sous-traitant européen
#                                                plus simple à justifier au
#                                                regard de la loi camerounaise
#                                                n° 2024/017.
#   Chatbot                 Groq                 Interactif : l'étudiant
#                                                attend sa réponse. Le modèle
#                                                reste collé aux passages du
#                                                RAG, il ne réécrit pas.
#   Embeddings              Mistral (europe)     Par API et non en local :
#                                                un modèle multilingue occupe
#                                                ~384 Mo de RAM rien que pour
#                                                son vocabulaire, le double au
#                                                chargement. L'hébergement en
#                                                a 512, et le palier payant
#                                                aussi.
#   Notifications           Twilio puis Meta     Twilio pour démarrer : bac à
#                                                sable actif en cinq minutes,
#                                                texte libre dans les 24 h.
#                                                Meta ensuite : c'est le seul
#                                                moyen d'écrire hors de cette
#                                                fenêtre, ce dont un rappel
#                                                d'échéance a besoin.
#   Paiement                pawaPay              Le seul agrégateur couvrant à
#                                                la fois le Cameroun (MTN,
#                                                Orange) et le Congo (MTN,
#                                                Airtel).
#
# Le secours est volontairement chez un autre hébergeur que le primaire. Deux
# clés du même fournisseur tombent en panne ensemble.


# --- Orchestrateur de modèle de langage -------------------------------------
# huggingface | groq | openai | mistral | ollama | mock
#
# Après avoir posé une clé : python -m scripts.verifier_cles
# Une clé valide ne garantit pas qu'un modèle réponde. Les fournisseurs
# retirent des modèles de leur palier gratuit sans prévenir — Groq a sorti
# llama-3.3-70b-versatile du sien le 16 août 2026 — et le symptôme est
# trompeur : l'orchestrateur bascule sur le secours et tout paraît marcher.
LLM_PROVIDER=groq
LLM_MODEL=
# Niveau 2 : bascule automatique. Chez un AUTRE hébergeur que le primaire,
# sans quoi les deux tombent ensemble. Vide = un seul niveau d'IA.
LLM_PROVIDER_SECOURS=mistral

# Par fonction. Vide = suit LLM_PROVIDER.
#
# La feuille de route part chez Mistral pour deux raisons : c'est le livrable
# payé, et c'est de loin le plus gros appel — il épuiserait à lui seul les
# 8 000 jetons par minute du palier gratuit de Groq.
LLM_PROVIDER_ORIENTATION=
LLM_MODELE_ORIENTATION=
LLM_PROVIDER_ROADMAP=mistral
LLM_MODELE_ROADMAP=
LLM_PROVIDER_CHATBOT=
LLM_MODELE_CHATBOT=

GROQ_API_KEY=
MISTRAL_API_KEY=
# OPENAI_API_KEY=
# Hugging Face : bon en secours, mauvais en primaire. Son palier gratuit est
# un crédit de 0,10 $ par mois, pas un quota de requêtes : quelques dizaines
# de feuilles de route l'épuisent, et l'API répond alors 402.
# HUGGINGFACE_API_KEY=


# --- Embeddings -------------------------------------------------------------
# false = recherche plein texte française seule. C'est l'état par défaut, et
# la recherche fonctionne : la voie lexicale est mesurée dans scripts/evaluer.
#
# ATTENTION : changer de fournisseur impose de ré-embedder TOUT le corpus
# (python -m scripts.reembedder). Les vecteurs de deux modèles vivent dans des
# espaces sans rapport, et la recherche renverrait du bruit sans lever
# d'erreur.
# Activés ici, et sans conséquence tant que MISTRAL_API_KEY est vide : la
# recherche reste alors en plein texte français, sans erreur. Dès que la clé
# est posée, ./demarrer.sh embedde le corpus tout seul.
EMBEDDINGS_ENABLED=true
EMBEDDINGS_FOURNISSEUR=mistral


# --- Comptes ----------------------------------------------------------------
# DOIT être posé en production : un secret tiré au hasard à chaque démarrage
# déconnecterait tout le monde à chaque redéploiement.
JWT_SECRET=


# --- Envoi des codes de vérification ---------------------------------------
# Sans SMTP, le code est écrit dans les journaux du serveur, et l'application
# dit où le lire. Démontrable, jamais acceptable en production.
#
# Réglages des fournisseurs courants, au choix :
#
#   Gmail       smtp.gmail.com / 587
#               utilisateur = l'adresse, mot de passe = un MOT DE PASSE
#               D'APPLICATION (celui du compte est refusé). 500 envois par
#               jour, et les messages vers des inconnus partent volontiers en
#               indésirables. Bon pour une démonstration, pas pour un
#               lancement.
#
#   Brevo       smtp-relay.brevo.com / 587
#               utilisateur = l'adresse du compte, mot de passe = la CLÉ SMTP.
#               300 envois par jour, gratuits sans limite de durée.
#
#   Mailjet     in-v3.mailjet.com / 587
#               utilisateur = la clé API, mot de passe = la clé secrète.
#
#   Resend      smtp.resend.com / 587
#               utilisateur = « resend », littéralement, identique pour tous.
#               mot de passe = la clé API. Exige un domaine vérifié.
#
# SMTP_EXPEDITEUR doit désigner une adresse que le fournisseur vous autorise à
# utiliser. Un domaine non vérifié se fait rejeter, ou part en indésirables —
# c'est la cause la plus fréquente d'un envoi qui marchait en test.
#
# Vérifier la configuration sans créer de compte :
#   curl -s localhost:8000/api/sante | grep -o '"courriel":{[^}]*}'
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=One Moov <ne-pas-repondre@one-moov.app>


# --- Notifications WhatsApp -------------------------------------------------
# mock | twilio | meta
#
# Sans TWILIO_ACCOUNT_SID ni TWILIO_AUTH_TOKEN, l'envoi retombe de lui-même en
# mode simulé et s'écrit dans les journaux, destinataire et contenu compris.
# Nommer twilio ici ne déclenche donc rien tant que les clés sont vides.
#
# NOTIFICATIONS_MOCK=true force le mode simulé QUELLES QUE SOIENT les clés.
# À garder sous la main pour répéter une démonstration sans consommer le
# quota d'un compte d'essai.
NOTIFICATIONS_FOURNISSEUR=twilio
NOTIFICATIONS_MOCK=false

# Twilio. Le bac à sable s'active en cinq minutes : depuis la console Twilio,
# l'étudiant envoie « join <deux-mots> » au +14155238886 et devient joignable.
# Dans les 24 h qui suivent, le texte est libre — aucun template à faire
# approuver. Limites d'un compte d'essai : un message toutes les 3 s, une
# cinquantaine par jour, et chaque destinataire doit se réinscrire tous les
# trois jours.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=+14155238886
TWILIO_ESSAI=true

# Meta Cloud API. Nécessite un numéro d'entreprise et des templates approuvés,
# mais permet d'écrire hors de la fenêtre de 24 h.
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=


# --- Paiement mobile money --------------------------------------------------
# pawapay | manuel | mock
#
# « manuel » : l'étudiant paie sur un numéro marchand existant et saisit sa
# référence, un administrateur valide. C'est le mode de lancement tant que
# l'onboarding de l'agrégateur n'est pas terminé.
# Seul réglage qui ne retombe PAS tout seul en mode simulé, et c'est
# volontaire : un paiement qui échouerait en silence laisserait croire qu'une
# somme a été encaissée. Nommer pawapay sans jeton produit une erreur visible.
# À ne changer qu'une fois l'onboarding marchand terminé.
PAIEMENT_FOURNISSEUR=mock
PAWAPAY_TOKEN=
PAWAPAY_SANDBOX=true
PAWAPAY_SIGNATURE_SECRET=
PAIEMENT_NUMERO_MARCHAND=


# --- Divers -----------------------------------------------------------------
ORIGINES_AUTORISEES=http://localhost:5173,https://one-moov.pages.dev
SEL_QUOTAS=
