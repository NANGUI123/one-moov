# ── Base de données ───────────────────────────────────────────────
# PostgreSQL (recommandé, prod). Ex : postgresql+psycopg://user:pass@localhost:5432/onemoov
# Si vide, l'app démarre sur SQLite (fichier onemoov.db) — pratique pour tester.
DATABASE_URL=

# ── LLM : Groq uniquement ─────────────────────────────────────────
GROQ_API_KEY=
# Cascade de modèles Groq : principal, puis secours (essayés dans l'ordre).
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
# Niveau 2 : secours chez un AUTRE hébergeur. Sans clé, le niveau est
# sauté et le mode guidé devient le seul repli.
SECOURS_API_KEY=
SECOURS_BASE_URL=https://api.mistral.ai/v1
SECOURS_MODELS=mistral-small-latest
# Modèle léger pour les tâches simples (frugalité tokens)
GROQ_MODEL_LEGER=llama-3.1-8b-instant

# ── Sécurité ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=720

# ── Tarification (partie payante = prix unique du parcours) ───────
PRIX_PARCOURS_EUR=80
TAUX_EUR_FCFA=655.957

# ── Paiement CinetPay ─────────────────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=SANDBOX
# URL publique de l'API (pour le retour webhook)
PUBLIC_BASE_URL=http://localhost:8000

# ── France Compétences (repli local si pas de LLM web) ────────────
FRANCE_COMPETENCES_BASE=https://api.francecompetences.fr

# ── Vérification RNCP par LLM connecté au web (point 8) ───────────
# OpenAI-compatible. Par défaut Perplexity (modèles « sonar », accès internet).
# Sans clé → repli sur l'export officiel France Compétences synchronisé localement.
RNCP_LLM_API_KEY=
RNCP_LLM_BASE_URL=https://api.perplexity.ai
RNCP_LLM_MODEL=sonar

# ── Vérification d'e-mail + envoi (SMTP via Brevo recommandé) ────
# Sans SMTP_HOST → mode démo (lien de vérification à l'écran).
# Configuration Brevo — 300 e-mails/j gratuits, serveurs UE :
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_USER=<login SMTP Brevo, format email>
#   SMTP_PASSWORD=<clé SMTP générée dans Brevo (pas le mot de passe compte)>
EMAIL_VERIFICATION_REQUISE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=One Moov <no-reply@onemoov.app>
SMTP_TLS=true

# ── WhatsApp Business API via Twilio ──────────────────────────────
# Sandbox actif en 5 min : l'étudiant envoie « join <code> » au numéro
# de test, on peut lui écrire pendant 3 j sans template.
# En production : numéro d'entreprise + templates Meta approuvés.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# SID du template Meta approuvé pour les rappels J-3 (obligatoire hors 24 h).
TWILIO_RAPPEL_TEMPLATE_SID=

# ── Garde-fous coûts / quotas ─────────────────────────────────────
QUOTA_MESSAGES_GRATUIT_JOUR=40
BUDGET_MENSUEL_USD=200
