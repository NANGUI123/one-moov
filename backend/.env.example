# ── Base de données ───────────────────────────────────────────────
# PostgreSQL (recommandé, prod). Ex : postgresql+psycopg://user:pass@localhost:5432/onemoov
# Si vide, l'app démarre sur SQLite (fichier onemoov.db) — pratique pour tester.
DATABASE_URL=

# ── LLM : Groq uniquement ─────────────────────────────────────────
GROQ_API_KEY=
# Cascade de modèles Groq : principal, puis secours (essayés dans l'ordre).
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Modèle léger pour les tâches simples (frugalité tokens)
GROQ_MODEL_LEGER=llama-3.1-8b-instant

# ── Sécurité ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=720

# ── Tarification (partie payante = prix unique du parcours) ───────
PRIX_PARCOURS_EUR=80
TAUX_EUR_FCFA=655.957

# ── Paiement CinetPay ─────────────────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=SANDBOX
# URL publique de l'API (pour le retour webhook)
PUBLIC_BASE_URL=http://localhost:8000

# ── France Compétences (repli local si pas de LLM web) ────────────
FRANCE_COMPETENCES_BASE=https://api.francecompetences.fr

# ── Vérification RNCP par LLM connecté au web (point 8) ───────────
# OpenAI-compatible. Par défaut Perplexity (modèles « sonar », accès internet).
# Sans clé → repli sur l'export officiel France Compétences synchronisé localement.
RNCP_LLM_API_KEY=
RNCP_LLM_BASE_URL=https://api.perplexity.ai
RNCP_LLM_MODEL=sonar

# ── Vérification d'e-mail + envoi (SMTP) ─────────────────────────
# EMAIL_VERIFICATION_REQUISE=true : connexion bloquée tant que l'e-mail n'est pas vérifié.
# Sans SMTP_HOST → mode démo : le lien de vérification s'affiche à l'écran (tests sans e-mail).
EMAIL_VERIFICATION_REQUISE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=One Moov <no-reply@onemoov.app>
SMTP_TLS=true

# ── Garde-fous coûts / quotas ─────────────────────────────────────
QUOTA_MESSAGES_GRATUIT_JOUR=40
BUDGET_MENSUEL_USD=200
